# Copy to .env and fill in. Used for local development only;
# Databricks Apps deployment reads config from app.yaml + resource binding.

# Workspace host (no trailing slash)
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com

# Auth — pick ONE
# Option 1: CLI profile (recommended for local dev)
DATABRICKS_PROFILE=DEFAULT
# Option 2: OAuth M2M (service principal)
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=
# Option 3: PAT (legacy, discouraged)
# DATABRICKS_TOKEN=

# SQL warehouse for system-table queries.
# In deployment this is auto-set by the resource binding; only needed locally.
DATABRICKS_WAREHOUSE_ID=

# Optional: workspace ID (defaults to the one inferred from DATABRICKS_HOST)
# DATABRICKS_WORKSPACE_ID=

# UC catalog/schema for app state (config, alert rules, audit, schedules).
# Defaults: main / po_monitor. The app SP needs CREATE SCHEMA / CREATE TABLE
# at first boot.
# PO_MONITOR_CATALOG=main
# PO_MONITOR_SCHEMA=po_monitor

# Optional: maintainer email — feedback submissions try to ping a Databricks
# notification destination at this address. Leave unset to skip email delivery
# (UC table persistence still works).
# PO_MONITOR_MAINTAINER_EMAIL=
