# Local-only deploy config. Copy to scripts/.deploy.env (gitignored) and fill in.
# scripts/deploy.sh sources this file when called without positional args.

# Required
WORKSPACE_HOST=https://<your-workspace>.cloud.databricks.com
WAREHOUSE_ID=<your-warehouse-id>

# Optional — defaults to "dev"
# TARGET=dev

# UC catalog/schema for app persistence (config, alert rules, audit, schedules…).
# The app SP needs CREATE SCHEMA + CREATE TABLE on the catalog at first boot.
# Default in source is `main`, but most workspaces lock that down — point at a
# catalog the app SP can write to.
# PO_MONITOR_CATALOG=
# PO_MONITOR_SCHEMA=po_monitor

# Optional — feedback delivery via Databricks notification destinations.
# Leave unset to skip email delivery; UC table persistence still works.
# PO_MONITOR_MAINTAINER_EMAIL=
